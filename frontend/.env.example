# MPLABS Drishti — Frontend Environment Variables
# Copy this file to .env and fill in your values

# Backend API (Production)
NEXT_PUBLIC_API_URL=https://mplads-backend.onrender.com/api

# Backend API (Local development — used automatically when on localhost)
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:5000/api

# AI Engine
NEXT_PUBLIC_AI_ENGINE_URL=http://localhost:8000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
