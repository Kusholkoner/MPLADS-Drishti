# ====================================================================
# MPLADS Sentinel - Backend .gitignore (Node.js / Express / Supabase)
# ====================================================================

# --------------------------------------------------------------------
# Dependencies
# --------------------------------------------------------------------
node_modules/
jspm_packages/
.pnp
.pnp.js

# --------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# --------------------------------------------------------------------
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging

# Allow committing environment templates/examples
!.env.example
!.env.template
!.env.*.example

# SSL & Security Credentials / Keys
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
serviceAccountKey.json
credentials.json
jwt_secret*.key
id_rsa*

# --------------------------------------------------------------------
# Runtime Uploads, Temporary & Storage Files
# --------------------------------------------------------------------
uploads/*
!uploads/.gitkeep
temp/
tmp/
*.tmp
*.temp
storage/
downloads/
cache/
.cache/

# --------------------------------------------------------------------
# Logs & Process Managers
# --------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Process IDs & PM2
pids/
*.pid
*.seed
*.pid.lock
.pm2/
pm2.log

# --------------------------------------------------------------------
# Testing & Code Coverage
# --------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
.clinic/

# --------------------------------------------------------------------
# Database Dumps & Local Engines
# --------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump
*.sql.gz
*.sql.tar.gz
dump.rdb
postgres-data/
supabase/.temp/
supabase/.branches/

# --------------------------------------------------------------------
# Build & Distribution Artifacts
# --------------------------------------------------------------------
dist/
build/
bin/

# --------------------------------------------------------------------
# IDE, Editors & OS Files
# --------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDEs & Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
