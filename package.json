{
  "name": "mplads-sentinel",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:ai": "python ai-engine/api.py",
    "dev:all": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:ai\"",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:ai\"",
    "test:ai": "python -m unittest discover ai-engine/tests",
    "test:e2e": "node scripts/test_e2e_integration.js",
    "build:frontend": "npm run build --workspace=frontend",
    "build": "npm run build --workspace=frontend"
  },
  "dependencies": {
    "concurrently": "^9.2.4"
  }
}
